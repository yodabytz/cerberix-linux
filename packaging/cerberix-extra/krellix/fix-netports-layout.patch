+        font.setPointSizeF(qMax(4.0, font.pointSizeF() * 0.75));
+    else if (font.pixelSize() > 0)
+        font.setPixelSize(qMax(5, qRound(font.pixelSize() * 0.75)));
+    return theme->font(QStringLiteral("netports"), font);
+#else
+    return font;
+#endif
+}
