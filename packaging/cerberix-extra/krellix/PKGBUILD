pkgrel=36
arch=('x86_64' 'aarch64')
url='https://github.com/yodabytz/krellix'
license=('GPL-3.0-or-later')
makedepends=('cmake' 'ninja' 'qt6-tools' 'qt6-base' 'python')
options=('!debug')
source=("krellix-0.1.2.tar.gz" "krellix.png" "org.cerberix.krellix.desktop")
