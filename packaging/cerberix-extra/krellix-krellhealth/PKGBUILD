# Maintainer: yodabytz <hello@cerberix.org>
pkgname=krellix-krellhealth
pkgver=0.1.2
pkgrel=5
arch=('x86_64' 'aarch64')
url='https://github.com/yodabytz/krellix'
license=('GPL-3.0-or-later')
pkgdesc='KrellHealth compact system health monitor plugin for Krellix'
depends=('krellix>=0.1.2' 'qt6-base')
optdepends=('smartmontools: SMART disk health checks'
            'zfs-utils: ZFS pool health checks'
            'btrfs-progs: Btrfs device error checks'
            'openssl: local certificate expiry checks'
            'systemd: failed unit and time sync checks')
makedepends=('cmake' 'ninja' 'qt6-tools' 'qt6-base')
options=('!debug')
source=("krellix-$pkgver.tar.gz"
        "fix-kernel-module-match.patch"
        "theme-heart-artwork.patch"
        "theme-heart-size.patch")
sha256sums=('18bc7af94d5db7bec2d50c8cb09e14fb244f994152d1006669efa51792e1ba45'
            '778e9770b4c15513b3ceb318df73c3861f3c57f3795bf1ca0732db278aab6058'
            '7b67d67d6aeb4a341eeedf7449ade93796bcf92a86e14edd7c828c92c16bd435'
            '60a6b4bf7841e896a16f55ac39a0fa70200437713b14bd0d87f07447b9a5bc42')

prepare() {
    cd "krellix-$pkgver"
    patch -Np1 -i "$srcdir/fix-kernel-module-match.patch"
    patch --fuzz=0 -Np1 -i "$srcdir/theme-heart-artwork.patch"
    patch --fuzz=0 -Np1 -i "$srcdir/theme-heart-size.patch"
}

build() {
    cd "krellix-$pkgver"
    cmake -GNinja -B build -S . \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build --target krellhealth
}

package() {
    cd "krellix-$pkgver"
    install -Dm755 build/plugins/libkrellhealth.so \
        "$pkgdir/usr/lib/krellix/plugins/libkrellhealth.so"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
